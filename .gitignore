.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# --- Environment & Configuration Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.conda/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django-specific database and generated static/media folders
db.sqlite3
db.sqlite3-journal
backend/media/
backend/staticfiles/
celerybeat-schedule
celerybeat.pid

# --- Node / Frontend (React + Vite) ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# --- Build Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Excel, Spreadsheets & Temporary Files ---
# Temporary/lock files created by Microsoft Office (highly recommended to ignore)
~$*.xlsx
~$*.xls
~$*.csv

# Ignore local datasets, test files, and generated output sheets
# (Uncomment the lines below if you do not want to track any Excel files in git.
#  This is highly recommended to prevent sensitive student marks from being committed.)
*.xlsx
*.xls
*.csv

.env.example
nginx

docker-compose.prod.yml
docker-compose.yml
